+@contextlib.contextmanager
+def _skill_oculta(project_root, skill_name: str):
+    """[patch local] Tira a skill REAL do caminho durante o eval.
+
+    O harness mede a descricao CANDIDATA criando uma copia temporaria em
+    .claude/commands/ com nome unico (<skill>-skill-<hex>), e detecta o
+    disparo procurando esse nome unico. Se a skill real ja estiver instalada
+    no projeto, o Claude invoca ELA -- Skill{"skill": "ufc-evento"} -- e a
+    deteccao le isso como "nao disparou": 0/3 em TODA consulta, positiva ou
+    negativa (o placar sai 50%, com recall=0). E, mesmo que a deteccao
+    aceitasse, quem teria disparado era a descricao ATUAL, nao a candidata.
+    Esconder a real conserta as duas coisas. As skills IRMAS ficam no lugar
+    de proposito: a concorrencia entre elas e parte do que se quer medir.
+    """
+    origem = Path(project_root) / ".claude" / "skills" / skill_name
+    if not origem.is_dir():
+        yield
+        return
+    destino = Path(project_root) / ".claude" / ".skills-ocultas-eval" / skill_name
+    destino.parent.mkdir(parents=True, exist_ok=True)
+    if destino.exists():
+        shutil.rmtree(destino)
+    shutil.move(str(origem), str(destino))
+    try:
+        yield
+    finally:
+        shutil.move(str(destino), str(origem))
+        with contextlib.suppress(OSError):
+            destino.parent.rmdir()
+
+
