# ambiente
.venv/
__pycache__/
*.pyc
.pytest_cache/
# settings.local.json e local; as SKILLS sao convencao do projeto e vao para o
# repo. Precisa ser ".claude/*" e nao ".claude/": o git nao reinclui arquivo
# dentro de diretorio excluido, so dentro de conteudo excluido.
.claude/*
!.claude/skills/

# dados brutos/processados e modelos: regeneraveis pelo pipeline
# (python -m scripts.run_pipeline --source github-mirror --fill-gap),
# grandes demais e sem valor de versionamento
data/raw/*
data/processed/
models/

# EXCECOES versionadas: entradas editadas a mao por evento
!data/raw/upcoming_card_odds.csv
!data/raw/manual_recent_fights.csv
# cache nome -> foto do UFC.com. Versionado porque re-obte-lo custa ~120
# requisicoes a 1 req/s: sem ele, um clone novo passa 2 minutos raspando o
# UFC.com para reconstruir o que ja estava pronto. Apague o arquivo (nao esta
# linha) quando quiser forcar re-busca.
!data/raw/fighter_photos.json

# artefatos locais de verificacao (screenshots, relatorio de rascunho na raiz)
card_report.html
shot_*.png
card_report_screenshot.png

# log da captura automatica (tarefa horaria)
data/auto_capture.log
